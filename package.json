{
  "name": "richertext",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "pnpm functions:build && pnpm stripe:secrets && node scripts/firebase.mjs emulators:exec --ui \"next dev\"",
    "emulators": "pnpm functions:build && node scripts/firebase.mjs emulators:start",
    "functions:build": "pnpm --dir functions build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/firebase.mjs emulators:exec --only auth,firestore \"playwright test\"",
    "test:emulators": "pnpm functions:build && node scripts/firebase.mjs emulators:exec --only auth,firestore,functions \"vitest run --config vitest.emulators.config.mts\"",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm test && pnpm test:emulators",
    "setup": "bash scripts/setup.sh",
    "stripe:setup": "node --env-file-if-exists=.env.local scripts/stripe-setup.mjs",
    "stripe:secrets": "node --env-file-if-exists=.env.local scripts/stripe-local.mjs secrets",
    "stripe:listen": "node --env-file-if-exists=.env.local scripts/stripe-local.mjs listen"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "firebase": "13.0.0",
    "firebase-admin": "14.5.0",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "stripe": "23.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "15.34.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@firebase/util",
      "protobufjs",
      "re2",
      "sharp",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": "22.x"
  }
}
