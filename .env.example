# Local settings. Copy to .env.local (the setup script does this) and fill in.
# Only this file is committed; real values never go in the repo (ADR 0009).

# Firebase: the emulators use a demo- project, so no real project or keys are needed (ADR 0018).
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-richertext

# Stripe sandbox (test mode) keys, only needed for payment flows (Phase 3).
# Get them from your Stripe dashboard in test mode: Developers → API keys.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
# Printed by `stripe listen --forward-to ...` when you start forwarding webhooks.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Production only, not needed locally: apphosting.yaml sets the Firebase
# project, auth domain and web API key (the key from Secret Manager), and the
# two Stripe secrets live in Secret Manager. See the README's Production section.
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_API_KEY=<web API key>
