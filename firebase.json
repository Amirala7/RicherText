{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "src", "*.log", "*.local"],
      "predeploy": ["pnpm --dir \"$RESOURCE_DIR\" build"]
    }
  ],
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  },
  "apphosting": [
    {
      "backendId": "richertext",
      "rootDir": "/",
      "ignore": [
        "node_modules",
        ".git",
        ".next",
        "functions/node_modules",
        "functions/lib",
        "functions/.secret.local",
        "e2e",
        "tests",
        "test-results",
        "playwright-report",
        "docs",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".env.local"
      ]
    }
  ]
}
